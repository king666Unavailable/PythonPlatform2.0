# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=

# Database
DATABASE_URL=
# MySQL account database used by the login API.
PYTHONPLATFORM_MYSQL_HOST=127.0.0.1
PYTHONPLATFORM_MYSQL_PORT=3306
PYTHONPLATFORM_MYSQL_USER=root
PYTHONPLATFORM_MYSQL_PASSWORD=
PYTHONPLATFORM_MYSQL_DATABASE=python_platform
# Optional read-only legacy data sources for the feature workspaces.
PYTHONPLATFORM_LEGACY_ROOT=
PYTHONPLATFORM_ALL_TEST_PATH=
PYTHONPLATFORM_SUBMIT_RECORDS_PATH=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Leave blank to use the Neo4j user's home database.
NEO4J_DATABASE=
# F06 read-only legacy snapshot path; do not commit a copy containing student data.
PYTHONPLATFORM_LEGACY_MASTERY_PATH=
# F07 read-only learning path definition path.
PYTHONPLATFORM_LEARNING_PATH_PATH=
PYTHONPLATFORM_CLASS_INFO_PATH=
PYTHONPLATFORM_MAKEUP_PATH=

# Session
DJANGO_SESSION_ENGINE=
DJANGO_SESSION_COOKIE_NAME=

# AI providers
AI_PROVIDER=
AI_API_KEY=
PYTHONPLATFORM_AI_API_URL=
PYTHONPLATFORM_AI_API_KEY=
PYTHONPLATFORM_AI_MODEL=
PYTHONPLATFORM_AI_API_TIMEOUT=30

# Code runner (Piston-compatible service; no local subprocess fallback)
PISTON_URL=
PISTON_API_TIMEOUT=60
